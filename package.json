{
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "displayName": "Trebired",
      "name": "trebired",
      "website": "https://trebired.com"
    }
  },
  "name": "@trebired/frontend",
  "version": "11.3.0",
  "description": "Generic browser runtime systems for Trebired frontend packages and applications.",
  "type": "module",
  "private": false,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./live": {
      "import": "./dist/live/index.js",
      "types": "./dist/live/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "files": [
    ".trebired/bundler/config.ts",
    ".trebired/logger/config.ts",
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs",
    "prepare:generated": "bun ./scripts/build/generated/namespace.mjs && bun node_modules/@trebired/code-discipline/dist/cli.js fix imports",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:pack && bun run verify:frontend",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:frontend": "bun ./scripts/verify/frontend.mjs",
    "verify:pack": "bun ./scripts/verify/pack.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.4.18",
    "@trebired/utils": "^0.8.0",
    "chart.js": "^4.5.1",
    "country-flag-icons": "^1.6.20",
    "cropperjs": "^1.6.2",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remixicon": "^4.9.1",
    "simple-icons": "^16.28.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@trebired/bundler": "^5.6.5",
    "@trebired/code-discipline": "^7.0.3",
    "@trebired/configs": "^0.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "frontend",
    "browser",
    "runtime",
    "typescript",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/frontend"
  },
  "homepage": "https://github.com/Trebired/frontend#readme",
  "bugs": {
    "url": "https://github.com/Trebired/frontend/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
