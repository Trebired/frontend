{
  "name": "@trebired/frontend",
  "version": "0.1.1",
  "description": "Generic browser runtime systems for Trebired frontend packages and applications.",
  "type": "module",
  "private": false,
  "license": "AGPL-3.0-only",
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "name": "trebired"
    }
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dom": {
      "import": "./dist/dom/index.js",
      "types": "./dist/dom/index.d.ts"
    },
    "./http": {
      "import": "./dist/http/index.js",
      "types": "./dist/http/index.d.ts"
    },
    "./actions": {
      "import": "./dist/actions/index.js",
      "types": "./dist/actions/index.d.ts"
    },
    "./flash": {
      "import": "./dist/flash/index.js",
      "types": "./dist/flash/index.d.ts"
    },
    "./progress": {
      "import": "./dist/progress/index.js",
      "types": "./dist/progress/index.d.ts"
    },
    "./layer": {
      "import": "./dist/layer/index.js",
      "types": "./dist/layer/index.d.ts"
    },
    "./tooltip": {
      "import": "./dist/tooltip/index.js",
      "types": "./dist/tooltip/index.d.ts"
    },
    "./popover": {
      "import": "./dist/popover/index.js",
      "types": "./dist/popover/index.d.ts"
    },
    "./modal": {
      "import": "./dist/modal/index.js",
      "types": "./dist/modal/index.d.ts"
    },
    "./inputs": {
      "import": "./dist/inputs/index.js",
      "types": "./dist/inputs/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./live": {
      "import": "./dist/live/index.js",
      "types": "./dist/live/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./styles": {
      "import": "./dist/styles/index.js",
      "types": "./dist/styles/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs",
    "prepare:generated": "bun node_modules/@trebired/code-discipline/dist/cli.js fix imports",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:pack && bun run verify:frontend",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:frontend": "bun ./scripts/verify/frontend.mjs",
    "verify:pack": "bun ./scripts/verify/pack.mjs"
  },
  "dependencies": {
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^4.9.2",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "frontend",
    "browser",
    "runtime",
    "typescript",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/frontend"
  },
  "homepage": "https://github.com/Trebired/frontend#readme",
  "bugs": {
    "url": "https://github.com/Trebired/frontend/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
